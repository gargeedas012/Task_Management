{
  "TodoDatabase": {
    "ConnectionString": "mongodb://localhost:27017",
    "DatabaseName": "TodoDB",
    "TodoCollectionName": "Todos",
    "UserCollectionName": "User"
  },
    "Jwt": {
      "Key": "my-super-secret-key-for-jwt-authentication-12345",
      "Issuer": "TodoApi",
      "Audience": "TodoClient",
      "ExpiryMinutes": 30
    },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
